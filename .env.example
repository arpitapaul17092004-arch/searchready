# SearchReady environment variables
# Copy to .env.local and fill in real values. Never commit real secrets.

# Public site URL (used for canonical URLs)
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Supabase (auth + history sync) ---
# Create a project at https://supabase.com, then:
#   1. Run supabase/migrations/0001_initial_schema.sql in the SQL editor
#      (RLS is enabled on every table by the migration).
#   2. Copy Project URL + anon public key from Project Settings > API.
# The ANON key is safe to expose to the browser ONLY with RLS enabled.
# The service_role key must NEVER be used in this app — leave it in the
# Supabase dashboard only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Optional: restrict API POST origins (comma-separated). If unset,
# same-origin requests only.
# API_ALLOWED_ORIGINS=https://searchready.example.com
